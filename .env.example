# Environment Variables Template
# Copy this file to .env.local and fill in actual values
# Never commit .env.local to Git

# ============================================
# Database Configuration
# ============================================
# DATABASE_URL=postgresql://user:password@localhost:5432/dbname
# DATABASE_URL_SHADOW=postgresql://user:password@localhost:5432/dbname_shadow

# ============================================
# API Configuration (Public - Exposed to Client)
# ============================================
# NEXT_PUBLIC_API_URL=https://api.yourdomain.com
# NEXT_PUBLIC_API_KEY=your_public_api_key

# ============================================
# Authentication & Security (Server-Side Only)
# ============================================
# JWT_SECRET=your_super_secret_jwt_key_min_32_chars
# JWT_EXPIRATION=7d
# NEXTAUTH_SECRET=your_nextauth_secret
# NEXTAUTH_URL=http://localhost:3000

# ============================================
# Third-Party Services
# ============================================
# STRIPE_SECRET_KEY=sk_test_xxxxx
# STRIPE_PUBLISHABLE_KEY=pk_test_xxxxx
# SENDGRID_API_KEY=SG.xxxxx
# GITHUB_CLIENT_ID=xxxxx
# GITHUB_CLIENT_SECRET=xxxxx

# ============================================
# Feature Flags
# ============================================
# NEXT_PUBLIC_ENABLE_ANALYTICS=true
# NEXT_PUBLIC_APP_ENV=production
# DEBUG_MODE=false

# ============================================
# Vercel Specific (Auto-set, don't modify)
# ============================================
# VERCEL=true
# VERCEL_ENV=production
# VERCEL_URL=your-project.vercel.app
